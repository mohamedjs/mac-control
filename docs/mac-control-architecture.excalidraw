      "isDeleted": false,
      "boundElements": null,
      "updated": 1794853338478,
      "link": null,
      "locked": false,
      "text": "input/application\nLiveInputSession (one per Mac)\n• moves in one tick → summed\n• sub-pixel remainder kept\n• click/key flushes the move first\n• wheel px → X11 notches (40 px)\n• releases held keys on disconnect",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 134,
      "containerId": "zstUexVgqkZGM_AGx8dGH",
      "originalText": "input/application\nLiveInputSession (one per Mac)\n• moves in one tick → summed\n• sub-pixel remainder kept\n• click/key flushes the move first\n• wheel px → X11 notches (40 px)\n• releases held keys on disconnect",
      "lineHeight": 1.25
    },
