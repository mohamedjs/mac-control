      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 74,
      "containerId": "E77Iyjdjk_JmZAqn6CGeX",
      "originalText": "WebSocket over Wi-Fi\nTCP_NODELAY · no deflate\ntiny JSON frames {t:'m', x, y}\n← pong + µs stats back",
      "lineHeight": 1.25
    },
    {
      "id": "gJcEPp64JGFPzQLd41kqu",
      "type": "text",
