      "boundElements": null,
      "updated": 1794853338477,
      "link": null,
      "locked": false,
      "text": "server/  HttpWsServer   GET /control · GET / (status, link only on loopback) · /health\nWS /control/ws  →  Origin must match host  ·  pairing key (constant-time compare)  ·  else 401 / 403",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 36,
      "containerId": "0kOO9PebN8dB8BGfvTDpO",
      "originalText": "server/  HttpWsServer   GET /control · GET / (status, link only on loopback) · /health\nWS /control/ws  →  Origin must match host  ·  pairing key (constant-time compare)  ·  else 401 / 403",
      "lineHeight": 1.25
    },
    {
      "id": "z6uo7HAjMW56U9ZfF5I1E",
      "type": "text",
      "x": 974.5,
      "y": 385,
      "width": 271,
      "height": 140,
